---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { tr } from '../i18n/utils';
import { profile } from '../data/portfolio';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const websiteLabel = profile.website.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<article class="card--profile">
  <div class="profile_image">
    <Image src={profile.photo} alt={profile.name} widths={[240, 360, 480]} sizes="(min-width: 900px) 320px, 80vw" />
  </div>

  <div class="profile_header">
    <h1 class="profile_name">{profile.name}</h1>
    <p class="profile_role">{tr(profile.role, lang)}</p>
    <p class="profile_location">{tr(profile.location, lang)}</p>
  </div>

  <div class="profile_contact">
    <a class="profile_link" href={`mailto:${profile.email}`}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="m2 7 10 6 10-6"></path>
      </svg>
      <span>{profile.email}</span>
    </a>
    <a class="profile_link" href={profile.whatsapp} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
      <span>{profile.phone}</span>
    </a>
    <a class="profile_link" href={profile.website} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M2 12h20"></path>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
      <span>{websiteLabel}</span>
    </a>
  </div>

  <ul class="profile_socials">
    {
      profile.socials.map((social) => (
        <li>
          <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name}>
            <Image src={social.icon} alt="" width={22} height={22} />
          </a>
        </li>
      ))
    }
  </ul>

  <p class="profile_bio">{tr(profile.description, lang)}</p>
</article>
