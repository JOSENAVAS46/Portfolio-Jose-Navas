---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const accents = [
  { name: 'terracota', value: 'hsl(14, 78%, 46%)' },
  { name: 'bosque', value: 'hsl(158, 42%, 38%)' },
  { name: 'azul klein', value: 'hsl(222, 68%, 52%)' },
  { name: 'ocre', value: 'hsl(38, 74%, 46%)' },
];
---

<div class="theme-controls">
  <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="true">
    <span class="theme-toggle_dot" aria-hidden="true"></span>
    <span id="theme-toggle-label">{t('theme.dark')}</span>
  </button>

  <div class="accents" role="group" aria-label={t('theme.accentLabel')}>
    {
      accents.map((accent, i) => (
        <button
          type="button"
          class="accents_item"
          data-accent={accent.value}
          style={`--swatch: ${accent.value}`}
          aria-label={accent.name}
          aria-pressed={i === 0 ? 'true' : 'false'}
        />
      ))
    }
  </div>
</div>

<script is:inline define:vars={{ darkLabel: t('theme.dark'), lightLabel: t('theme.light') }}>
  (function () {
    const root = document.documentElement;
    const toggle = document.getElementById('theme-toggle');
    const label = document.getElementById('theme-toggle-label');
    const swatches = Array.from(document.querySelectorAll('.accents_item'));

    function syncToggle() {
      const isDark = root.classList.contains('dark');
      if (label) label.textContent = isDark ? darkLabel : lightLabel;
      if (toggle) toggle.setAttribute('aria-pressed', String(isDark));
    }

    function syncAccent(value) {
      swatches.forEach((btn) => {
        btn.setAttribute('aria-pressed', String(btn.getAttribute('data-accent') === value));
      });
    }

    syncToggle();

    try {
      const storedAccent = localStorage.getItem('accent');
      if (storedAccent) syncAccent(storedAccent);
    } catch (e) {}

    toggle?.addEventListener('click', () => {
      const isDark = root.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
      syncToggle();
    });

    swatches.forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.getAttribute('data-accent');
        if (!value) return;
        root.style.setProperty('--accent', value);
        syncAccent(value);
        try {
          localStorage.setItem('accent', value);
        } catch (e) {}
      });
    });
  })();
</script>
